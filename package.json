{
  "name": "private-session-dummy",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Unreleased local encrypted-profile preview; NOT a secure messenger",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never",
    "build:mac": "electron-builder --mac zip --x64 --arm64 --publish never",
    "build:win:main": "electron-builder --win portable --x64 --publish never --config.extraMetadata.privateSessionVariant=main --config.directories.output=dist/main --config.win.artifactName=PrivateSession-Main-${arch}.${ext}",
    "build:win:protected": "electron-builder --win portable --x64 --publish never --config.extraMetadata.privateSessionVariant=protected --config.directories.output=dist/protected --config.win.artifactName=PrivateSession-Protected-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.privatesession.preview",
    "productName": "Private Session Dummy Preview",
    "asar": true,
    "files": [
      "crypto-probe/src/identity.mjs",
      "crypto-probe/src/local-profiles.mjs",
      "app/**/*",
      "ui/**/*",
      "core/**/*",
      "package.json",
      "crypto-probe/src/pinned-client.mjs",
      "crypto-probe/src/desktop-chat.mjs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PrivateSession-Dummy-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "PrivateSession-Dummy-Mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Local camera preview test only.",
        "NSMicrophoneUsageDescription": "Local microphone preview test only."
      }
    }
  },
  "dependencies": {
    "libp2p": "3.3.11",
    "@libp2p/tcp": "11.0.28",
    "@libp2p/noise": "17.0.3",
    "@libp2p/yamux": "8.0.3",
    "@libp2p/websockets": "10.1.21",
    "@libp2p/circuit-relay-v2": "4.2.13",
    "@libp2p/identify": "4.1.14",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/utils": "7.4.1",
    "@multiformats/multiaddr": "13.0.3",
    "@libp2p/peer-id": "6.0.14"
  }
}
